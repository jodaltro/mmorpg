        {
          "op": "assert",
          "fact": {
            "p": "seal-broken",
            "s": "selo"
          }
        },
        {
          "op": "assert",
          "fact": {
            "p": "poisoned",
            "s": "poco"
          }
        },
        {
          "op": "emit",
          "event": "omen",
          "public": true,
          "text": "A terra treme durante a noite na Floresta Cinzenta."
        }
      ]
    },
    {
      "id": "doenca",
      "every": 3,
      "when": {
        "fact": {
          "p": "poisoned",
          "s": "poco"
        }
      },
      "effects": [
        {
          "op": "adjust",
          "e": "vila",
          "k": "health",
          "d": -5,
          "min": 0
        }
      ]
    },
    {
      "id": "surto",
      "every": 3,
      "when": {
        "all": [
          {
            "fact": {
              "p": "poisoned",
              "s": "poco"
            }
          },
          {
            "num": {
              "e": "vila",
              "k": "health",
              "op": "<",
              "v": 70
            }
          },
          {
            "not": {
              "fact": {
                "p": "outbreak",
                "s": "vila"
              }
            }
          }
        ]
      },
      "effects": [
        {
          "op": "assert",
          "fact": {
            "p": "outbreak",
            "s": "vila"
          }
        },
        {
          "op": "emit",
          "event": "outbreak",
          "public": true,
          "text": "Os aldeoes da Vila Cinzenta estao adoecendo.",
          "reveals": {
            "p": "outbreak",
            "s": "vila"
          }
        }
      ]
    },
    {
      "id": "recuperacao",
      "every": 4,
      "when": {
        "all": [
          {
            "not": {
              "fact": {
