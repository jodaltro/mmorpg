      },
      "effects": [
        {
          "op": "adjust",
          "e": "vila",
          "k": "health",
          "d": 4,
          "max": 100
        }
      ]
    },
    {
      "id": "fim-surto",
      "every": 4,
      "when": {
        "all": [
          {
            "not": {
              "fact": {
                "p": "poisoned",
                "s": "poco"
              }
            }
          },
          {
            "fact": {
              "p": "outbreak",
              "s": "vila"
            }
          },
          {
            "num": {
              "e": "vila",
              "k": "health",
              "op": ">=",
              "v": 90
            }
          }
        ]
      },
      "effects": [
        {
          "op": "retract",
          "fact": {
            "p": "outbreak",
            "s": "vila"
          }
