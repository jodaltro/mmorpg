# Backend environment only. Never put database URLs or secret keys under Assets.
DATABASE_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
AUTH_MODE=auth-server
AUTH_AUDIENCE=authenticated
ALLOW_LOCAL_AUTH=true
LISTEN_ADDR=127.0.0.1:8093
ENABLE_DEV_IMPORT=false

# Optional two EXISTING users for an explicitly approved isolated development integration test.
# Leave empty outside that manual test. Values never belong in version control.
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_PASSWORD_A=
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_PASSWORD_B=
